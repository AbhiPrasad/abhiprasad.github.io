        </div>
        <div class="context-legend"><span><i></i> New messages</span><span><i class="context-reuse-key"></i> Shared prefix: may be cached</span><span>Token limit →</span></div>
      </div>
      <p class="planning-source"><a href="https://platform.openai.com/docs/guides/conversation-state">OpenAI, Conversation state ↗</a> · <a href="https://developers.openai.com/api/docs/guides/prompt-caching">OpenAI, Prompt caching ↗</a> · <a href="https://www.anthropic.com/research/effective-harnesses-for-long-running-agents">Anthropic, Long-running agents (2025) ↗</a></p>
    </section>
  </section>
</PresentationLayout>

<script>
  const evalSlide = document.querySelector<HTMLElement>(".eval-evidence-slide");
  const evalControls = evalSlide?.querySelectorAll<HTMLButtonElement>("[data-eval-view]");
  evalSlide?.querySelector("[data-trace-viewer]")?.addEventListener("click", (event) => {
    const row = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-span-target]");
    if (!row) return;
    evalControls?.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.evalView === row.dataset.spanTarget)));
  });
  evalControls?.forEach((button) => {
    button.addEventListener("click", () => {
      evalSlide?.querySelector<HTMLButtonElement>(`[data-span-target="${button.dataset.evalView}"]`)?.click();
    });
  });

  const annotation = document.querySelector<HTMLElement>(".observe-annotation");
  if (annotation) {
    const viewer = annotation.querySelector<HTMLElement>(".trace-viewer");
    const target = annotation.querySelector<HTMLElement>('[data-span-target="tool"]');
    const label = annotation.querySelector<HTMLElement>(".observe-review");
    const pointer = annotation.querySelector<SVGSVGElement>(".observe-pointer");
    const line = pointer?.querySelector<SVGPathElement>("[data-pointer-line]");
    const head = pointer?.querySelector<SVGPathElement>("[data-pointer-head]");
    const toggle = annotation.closest("section")?.querySelector<HTMLButtonElement>(".observe-toggle");
    const updatePointer = () => {
      if (!viewer || !target || !label || !pointer || !line || !head) return;
      const bounds = annotation.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      const scale = annotation.offsetWidth / bounds.width;
      const row = target.getBoundingClientRect();
      const note = label.getBoundingClientRect();
      const x = (row.left - bounds.left) * scale + 22;
      const y = (row.top - bounds.top + row.height / 2) * scale;
      const startX = (note.left - bounds.left) * scale - 10;
      const startY = (note.top - bounds.top + note.height / 2) * scale;
      pointer.setAttribute("viewBox", `0 0 ${annotation.offsetWidth} ${annotation.offsetHeight}`);
      line.setAttribute("d", `M ${startX} ${startY} H -12 V ${y} H ${x}`);
      head.setAttribute("d", `M ${x - 6} ${y - 5} L ${x} ${y} L ${x - 6} ${y + 5}`);
    };
    viewer?.addEventListener("click", (event) => {
      const row = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-span-target]");
      if (!row || !label || !pointer || !toggle) return;
      const inspecting = row.dataset.spanTarget === "tool";
      label.hidden = !inspecting;
      pointer.toggleAttribute("hidden", !inspecting);
      toggle.textContent = inspecting ? "← See the whole run" : "Inspect the action →";
      toggle.setAttribute("aria-pressed", String(inspecting));
      if (inspecting) requestAnimationFrame(updatePointer);
    });
    toggle?.addEventListener("click", () => {
      const next = toggle.getAttribute("aria-pressed") === "true" ? "run" : "tool";
      viewer?.querySelector<HTMLButtonElement>(`[data-span-target="${next}"]`)?.click();
    });
    new ResizeObserver(updatePointer).observe(annotation);
    new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) requestAnimationFrame(updatePointer);
    }).observe(annotation);
    window.addEventListener("resize", updatePointer);
  }
</script>
