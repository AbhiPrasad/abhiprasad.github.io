---
interface Props { caption?: string; }
const { caption } = Astro.props;
---
<div class="eval-flywheel">
  <svg viewBox="0 0 1080 330" role="img" aria-label="Observe: capture runs. Analyze: find patterns and curate cases. Evaluate: measure behavior. Improve: test changes and ship. Then return to Observe.">
    <defs><marker id="flywheel-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L10 5 L0 10z" style="fill: var(--bt-ccff80)" /></marker></defs>
    <g class="flywheel-links" marker-end="url(#flywheel-arrow)">
      <path d="M425 70 H655" /><path d="M850 120 V210" />
      <path d="M655 260 H425" /><path d="M230 210 V120" />
    </g>
    <g class="flywheel-node"><rect x="35" y="20" width="390" height="100" rx="10" /><text x="230" y="62">01 Observe</text><text class="flywheel-subtitle" x="230" y="94">Capture runs</text></g>
    <g class="flywheel-node"><rect x="655" y="20" width="390" height="100" rx="10" /><text x="850" y="62">02 Analyze</text><text class="flywheel-subtitle" x="850" y="94">Find patterns · curate cases</text></g>
    <g class="flywheel-node"><rect x="655" y="210" width="390" height="100" rx="10" /><text x="850" y="252">03 Evaluate</text><text class="flywheel-subtitle" x="850" y="284">Measure behavior</text></g>
    <g class="flywheel-node"><rect x="35" y="210" width="390" height="100" rx="10" /><text x="230" y="252">04 Improve</text><text class="flywheel-subtitle" x="230" y="284">Test changes · ship</text></g>
    <g class="flywheel-center" aria-hidden="true">
      <path d="M523 158a19 19 0 0 1 33-8l5 5m0 0v-10m0 10h-10" />
      <path d="M557 172a19 19 0 0 1-33 8l-5-5m0 0v10m0-10h10" />
    </g>
  </svg>
  {caption && <div class="flywheel-caption">{caption}</div>}
</div>
