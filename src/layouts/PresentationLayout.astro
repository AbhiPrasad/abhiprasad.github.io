---
import "reveal.js/reveal.css";
import "reveal.js/theme/white.css";

interface Props {
  title: string;
  description: string;
  theme?: "default" | "braintrust";
}

const { title, description, theme = "default" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title} - Abhijeet Prasad</title>
    {theme === "braintrust" && (
      <script is:inline>
        try {
          if (localStorage.getItem("deck-color-scheme") === "light") {
            document.documentElement.dataset.colorScheme = "light";
          }
        } catch {}
      </script>
    )}
  </head>
  <body data-deck-theme={theme}>
    <a class="back-link" href="/slides/">&larr; All slide decks</a>
    {theme === "braintrust" && (
      <button type="button" class="color-scheme-toggle" aria-pressed="false" title="Toggle light/dark theme (L)">
        <span class="color-scheme-toggle-label">Light theme</span>
      </button>
    )}
    <div class="reveal">
      <div class="slides">
        <slot />
      </div>
      {theme === "braintrust" && (
        <div class="deck-footer" hidden>
          <div class="deck-footer-source"></div>
          <div class="deck-footer-meta">
            <span>Evaling Agentic Systems <span class="deck-footer-divider">·</span> Abhijeet Prasad</span>
            <span class="deck-footer-count" aria-label="Slide number"></span>
          </div>
        </div>
      )}
    </div>
    <noscript><p>Enable JavaScript to use slide navigation.</p></noscript>
    <script>
      import Reveal from "reveal.js";

      const deck = new Reveal({
        ...(document.body.dataset.deckTheme === "braintrust"
          ? { width: 1280, height: 720 }
          : {}),
        hash: true,
        controls: true,
        progress: true,
        slideNumber: document.body.dataset.deckTheme === "braintrust" ? false : "c/t",
        transition: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "none"
          : "slide",
      });
      const footer = document.querySelector<HTMLElement>(".deck-footer");
      const footerCount = footer?.querySelector<HTMLElement>(".deck-footer-count");
      const footerSource = footer?.querySelector<HTMLElement>(".deck-footer-source");
      const updateFooter = () => {
        if (!footer || !footerCount || !footerSource) return;
        const slide = deck.getCurrentSlide();
        footer.hidden = slide?.classList.contains("title-slide") ?? true;
        footerCount.textContent = `${deck.getSlidePastCount() + 1} / ${deck.getTotalSlides()}`;
        const source = slide?.querySelector(".planning-source");
        footerSource.replaceChildren(...Array.from(source?.childNodes ?? [], (node) => node.cloneNode(true)));
        footerSource.hidden = !source;
      };
      const schemeToggle = document.querySelector<HTMLButtonElement>(".color-scheme-toggle");
      const root = document.documentElement;
      const applyScheme = (scheme: "light" | "dark") => {
        if (scheme === "light") root.dataset.colorScheme = "light";
        else delete root.dataset.colorScheme;
        if (schemeToggle) {
          schemeToggle.setAttribute("aria-pressed", String(scheme === "light"));
          schemeToggle.querySelector(".color-scheme-toggle-label")!.textContent =
            scheme === "light" ? "Dark theme" : "Light theme";
        }
      };
      if (schemeToggle) {
        applyScheme(root.dataset.colorScheme === "light" ? "light" : "dark");
        const toggleScheme = () => {
          const next = root.dataset.colorScheme === "light" ? "dark" : "light";
          applyScheme(next);
          try { localStorage.setItem("deck-color-scheme", next); } catch {}
        };
        schemeToggle.addEventListener("click", toggleScheme);
        deck.addKeyBinding({ keyCode: 76, key: "L", description: "Toggle light/dark theme" }, toggleScheme);
      }
      deck.on("ready", updateFooter);
      deck.on("slidechanged", updateFooter);
      deck.initialize();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --r-main-font: system-ui, sans-serif;
    --r-heading-font: system-ui, sans-serif;
    --r-heading-color: #1a6b1a;
    --r-link-color: #228b22;
    --r-link-color-hover: #1a6b1a;
    --r-selection-background-color: #daa520;
    --r-heading-text-transform: none;
  }

  .back-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    background: white;
    color: #1a6b1a;
    font: 0.875rem system-ui, sans-serif;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .reveal .eyebrow {
    color: #666;
    font-size: 0.5em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media print {
    .back-link {
      display: none;
    }
  }
</style>
